{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=ClaimsModule;User Id=sa;Password=__SET_VIA_ENVIRONMENT__;Encrypt=True;TrustServerCertificate=True"
  },
  "Storage": {
    "Provider": "AzureBlob",
    "Azure": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "Container": "claim-documents"
    },
    "Local": { "RootPath": "uploads" },
    "MaxFileSizeBytes": 52428800
  },
  "Auth": {
    "Jwt": {
      "Issuer": "ClaimsModule.Development",
      "Audience": "ClaimsModule.Client.Development",
      "SigningKey": "__SET_VIA_USER_SECRETS_MINIMUM_32_CHARACTERS__",
      "ExpirationMinutes": 480
    },
    "DevLoginEnabled": true
  },
  "Hangfire": { "DashboardEnabled": false },
  "Cors": { "Origins": ["http://localhost:4200"] },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
