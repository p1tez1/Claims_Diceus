{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=ClaimsModule;User Id=sa;Password=__SET_VIA_ENVIRONMENT__;Encrypt=True;TrustServerCertificate=True"
  },
  "Storage": {
    "Provider": "AzureBlob",
    "Azure": {
      "ConnectionString": "__SET_VIA_ENVIRONMENT__",
      "Container": "claim-documents"
    },
    "Local": { "RootPath": "uploads" },
    "MaxFileSizeBytes": 52428800
  },
  "Auth": {
    "Jwt": {
      "Issuer": "ClaimsModule",
      "Audience": "ClaimsModule.Client",
      "SigningKey": "__SET_VIA_ENVIRONMENT_MINIMUM_32_CHARACTERS__",
      "ExpirationMinutes": 60
    },
    "DevLoginEnabled": false
  },
  "Hangfire": { "DashboardEnabled": false },
  "Cors": { "Origins": [] },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
